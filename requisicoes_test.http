### ==========================================
### MÓDULO: MENSAGEM TRIAGEM
### ==========================================





### VARIÁVEIS

@idTriagem = 2
@idMensagem = 4



### 2. CRIAR MENSAGEM DO PACIENTE
POST {{baseUrl}}/mensagens-triagem
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "id_triagem": {{idTriagem}},
  "autor": "PACIENTE",
  "conteudo": "Estou sentindo dor de cabeça há dois dias.",
  "ordem": 1
}


### 3. CRIAR MENSAGEM DA IA
POST {{baseUrl}}/mensagens-triagem
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "id_triagem": {{idTriagem}},
  "autor": "IA",
  "conteudo": "Você está sentindo algum outro sintoma?",
  "ordem": 2
}


### 4. LISTAR TODAS AS MENSAGENS
GET {{baseUrl}}/mensagens-triagem
Authorization: Bearer {{token}}


### 5. BUSCAR MENSAGEM POR ID
GET {{baseUrl}}/mensagens-triagem/{{idMensagem}}
Authorization: Bearer {{token}}


### 6. ATUALIZAR MENSAGEM
PUT {{baseUrl}}/mensagens-triagem/{{idMensagem}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "conteudo": "Estou sentindo dor na perna há três dias."
}


### 7. EXCLUIR MENSAGEM
DELETE {{baseUrl}}/mensagens-triagem/{{idMensagem}}
Authorization: Bearer {{token}}


### 8. VERIFICAR MENSAGEM EXCLUÍDA
GET {{baseUrl}}/mensagens-triagem/{{idMensagem}}
Authorization: Bearer {{token}}




